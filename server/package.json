{
  "name": "@bridge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./src/client.ts"
    }
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.client.json",
    "codegen": "tsc -p tsconfig.client.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cd .. && vitest run --project server",
    "start": "node src/main.ts",
    "logs": "node src/logsCli.ts",
    "probe:side": "node src/probeSideCli.ts"
  },
  "dependencies": {
    "@bridge/contract": "workspace:*",
    "@bridge/shared": "workspace:*",
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "pino": "catalog:",
    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/web-push": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
