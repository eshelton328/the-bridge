{
  "name": "the-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "codegen": "pnpm --filter @bridge/web --filter @bridge/server codegen",
    "check:css": "pnpm --filter @bridge/web exec panda cssgen --max-warnings 0",
    "gen:routes": "node scripts/genRoutes.ts",
    "check:routes": "node scripts/genRoutes.ts --check",
    "gen:registry": "node scripts/genRegistry.ts",
    "check:registry": "node scripts/genRegistry.ts --check",
    "new": "node scripts/new.ts",
    "fidelity": "node scripts/fidelity/fidelity.ts",
    "fidelity:refs": "node scripts/fidelity/buildReferences.ts",
    "fidelity:check-build": "node scripts/fidelity/checkBuild.ts",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint --max-warnings 0 .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "knip": "knip",
    "logs": "pnpm --filter @bridge/server --silent logs",
    "probe:side": "pnpm --filter @bridge/server --silent probe:side",
    "check:agents-md": "node scripts/checkAgentsMd.ts",
    "check:cycles": "node scripts/checkCycles.ts",
    "check:structure": "node scripts/checkStructure.ts",
    "check:states": "node scripts/checkStates.ts",
    "test:scripts": "node --test scripts/*.test.ts scripts/fidelity/*.test.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project shared --project contract --project server --project web ${VITEST_SHARD:+--shard=$VITEST_SHARD}",
    "test:e2e": "vitest run --config e2e/vitest.config.ts",
    "test:stories": "vitest run --project storybook",
    "build": "pnpm --filter @bridge/web build",
    "build:canvas": "pnpm --filter @bridge/web build:canvas",
    "check:ci": "node scripts/checkCi.ts",
    "check:reviews": "node scripts/fidelity/checkReviews.ts",
    "shard:times": "node scripts/shardTimes.ts",
    "keyboard:served": "node scripts/keyboardCheck.ts",
    "keyboard:slide": "node scripts/keyboardSlide.ts",
    "build-storybook": "pnpm --filter @bridge/web build-storybook",
    "verify": "pnpm codegen && pnpm check:css && pnpm check:routes && pnpm check:registry && pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm check:agents-md && pnpm check:cycles && pnpm check:structure && pnpm check:states && pnpm check:reviews && pnpm check:ci && pnpm test:scripts && pnpm test:unit && pnpm test:stories && pnpm build && pnpm build:canvas && pnpm build-storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@bridge/contract": "workspace:*",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@pandacss/eslint-plugin": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/router-generator": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-check-file": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
