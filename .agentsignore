# Folders that do not get their own AGENTS.md; they use the nearest
# ancestor's. Gitignore syntax. Dot-folders and gitignored paths are always
# skipped. scripts/checkAgentsMd.ts reads this file.

# Source of the shared, contract and server packages; each package's AGENTS.md covers it
shared/src/
contract/src/
server/src/

# The folders inside a page; the page's AGENTS.md covers them
web/src/pages/*/screens/
web/src/pages/*/blocks/
web/src/pages/*/states/

# Templates of `pnpm new`; scripts/AGENTS.md covers them
scripts/templates/

# The Figma references, one folder per page and frame; references/AGENTS.md covers them
references/*/
